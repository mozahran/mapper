{
    "name": "zahran/mapper",
    "description": "Compile a JSON mapping template once, map many payloads with it.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Zahran",
            "email": "m.zahran90@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Zahran\\Mapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zahran\\Mapper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
